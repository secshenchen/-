<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Pelican Riding a Bicycle</title>
<style>
  :root {
    --sky: #8fd3ff;
    --sky-deep: #48a7dc;
    --road: #39444f;
    --road-line: #f7f0b2;
    --bike: #1f2937;
    --bike-red: #ef4444;
    --pelican-white: #fff8e9;
    --pelican-shadow: #eadfc7;
    --wing: #f7edda;
    --beak: #f59e0b;
    --beak-dark: #d97706;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    min-height: 100vh;
    display: grid;
    place-items: center;
    background: linear-gradient(180deg, #d9f3ff 0%, #ffffff 100%);
    font-family: Arial, Helvetica, sans-serif;
  }

  .stage {
    width: min(100vw, 1100px);
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #8fd3ff;
    border-radius: 18px;
    box-shadow: 0 24px 70px rgba(15, 23, 42, 0.2);
  }

  svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .clouds { animation: cloudsMove 18s linear infinite; }
  .clouds.back {
    animation-duration: 28s;
    opacity: 0.55;
  }

  .road-lines { animation: roadMove 1.2s linear infinite; }

  .wheel {
    transform-box: fill-box;
    transform-origin: center;
    animation: spin 0.7s linear infinite;
  }

  .crank {
    transform-origin: 480px 354px;
    animation: spin 0.7s linear infinite;
  }

  .pedal {
    transform-box: fill-box;
    transform-origin: center;
    animation: counterSpin 0.7s linear infinite;
  }

  .pelican { animation: birdBob 0.7s ease-in-out infinite; }

  .head {
    transform-origin: 578px 179px;
    animation: headNod 1.4s ease-in-out infinite;
  }

  .wing {
    transform-origin: 470px 232px;
    animation: wingFlap 0.7s ease-in-out infinite;
  }

  .tail {
    transform-origin: 374px 267px;
    animation: tailWag 0.7s ease-in-out infinite;
  }

  .front-leg {
    transform-origin: 501px 298px;
    animation: frontLeg 0.7s ease-in-out infinite;
  }

  .back-leg {
    transform-origin: 439px 300px;
    animation: backLeg 0.7s ease-in-out infinite;
  }

  .shadow { animation: shadowPulse 0.7s ease-in-out infinite; }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  @keyframes counterSpin {
    to { transform: rotate(-360deg); }
  }

  @keyframes birdBob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-7px); }
  }

  @keyframes headNod {
    0%, 100% { transform: rotate(0deg); }
    50% { transform: rotate(4deg); }
  }

  @keyframes wingFlap {
    0%, 100% { transform: rotate(-7deg); }
    50% { transform: rotate(11deg) translateY(3px); }
  }

  @keyframes tailWag {
    0%, 100% { transform: rotate(-2deg); }
    50% { transform: rotate(7deg); }
  }

  @keyframes frontLeg {
    0%, 100% { transform: rotate(-13deg); }
    50% { transform: rotate(19deg); }
  }

  @keyframes backLeg {
    0%, 100% { transform: rotate(18deg); }
    50% { transform: rotate(-15deg); }
  }

  @keyframes cloudsMove {
    from { transform: translateX(0); }
    to { transform: translateX(-520px); }
  }

  @keyframes roadMove {
    from { transform: translateX(0); }
    to { transform: translateX(-160px); }
  }

  @keyframes shadowPulse {
    0%, 100% { transform: scaleX(1); opacity: 0.25; }
    50% { transform: scaleX(0.92); opacity: 0.18; }
  }
</style>
</head>

<body>
  <main class="stage">
    <svg viewBox="0 0 960 540" role="img">
      <defs>
        <linearGradient id="skyGradient" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#69c8fb"/>
          <stop offset="66%" stop-color="#bdefff"/>
          <stop offset="100%" stop-color="#dff9ff"/>
        </linearGradient>

        <linearGradient id="roadGradient" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#4b5563"/>
          <stop offset="100%" stop-color="#1f2937"/>
        </linearGradient>

        <radialGradient id="sunGlow" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#fff7ad"/>
          <stop offset="55%" stop-color="#fde68a"/>
          <stop offset="100%" stop-color="#facc15" stop-opacity="0"/>
        </radialGradient>

        <filter id="softShadow" x="-30%" y="-30%" width="160%" height="160%">
          <feGaussianBlur stdDeviation="4"/>
        </filter>

        <g id="cloud">
          <ellipse cx="0" cy="18" rx="42" ry="18" fill="#ffffff"/>
          <ellipse cx="35" cy="10" rx="34" ry="24" fill="#ffffff"/>
          <ellipse cx="72" cy="18" rx="48" ry="19" fill="#ffffff"/>
          <rect x="-2" y="16" width="108" height="22" rx="12" fill="#ffffff"/>
        </g>

        <g id="wheelSpokes">
          <line x1="0" y1="-52" x2="0" y2="52" stroke="#e5e7eb" stroke-width="3"/>
          <line x1="-52" y1="0" x2="52" y2="0" stroke="#e5e7eb" stroke-width="3"/>
          <line x1="-37" y1="-37" x2="37" y2="37" stroke="#e5e7eb" stroke-width="3"/>
          <line x1="37" y1="-37" x2="-37" y2="37" stroke="#e5e7eb" stroke-width="3"/>
          <line x1="-20" y1="-48" x2="20" y2="48" stroke="#e5e7eb" stroke-width="2"/>
          <line x1="20" y1="-48" x2="-20" y2="48" stroke="#e5e7eb" stroke-width="2"/>
        </g>
      </defs>

      <rect width="960" height="540" fill="url(#skyGradient)"/>
      <circle cx="790" cy="96" r="82" fill="url(#sunGlow)"/>
      <circle cx="790" cy="96" r="42" fill="#fde68a"/>

      <g class="clouds back">
        <use href="#cloud" x="80" y="75"/>
        <use href="#cloud" x="375" y="120"/>
        <use href="#cloud" x="700" y="66"/>
        <use href="#cloud" x="1030" y="110"/>
        <use href="#cloud" x="1320" y="72"/>
      </g>

      <g class="clouds">
        <use href="#cloud" x="210" y="160"/>
        <use href="#cloud" x="560" y="148"/>
        <use href="#cloud" x="930" y="168"/>
        <use href="#cloud" x="1260" y="150"/>
      </g>

      <path d="M0 338 C155 290 255 325 390 302 C545 275 680 320 960 284 L960 430 L0 430 Z" fill="#7cc86f"/>
      <path d="M0 365 C172 320 300 352 462 330 C630 306 780 340 960 318 L960 430 L0 430 Z" fill="#59b65d"/>
      <rect x="0" y="405" width="960" height="135" fill="url(#roadGradient)"/>

      <g class="road-lines">
        <rect x="25" y="466" width="92" height="8" rx="4" fill="var(--road-line)"/>
        <rect x="185" y="466" width="92" height="8" rx="4" fill="var(--road-line)"/>
        <rect x="345" y="466" width="92" height="8" rx="4" fill="var(--road-line)"/>
        <rect x="505" y="466" width="92" height="8" rx="4" fill="var(--road-line)"/>
        <rect x="665" y="466" width="92" height="8" rx="4" fill="var(--road-line)"/>
        <rect x="825" y="466" width="92" height="8" rx="4" fill="var(--road-line)"/>
        <rect x="985" y="466" width="92" height="8" rx="4" fill="var(--road-line)"/>
      </g>

      <ellipse class="shadow" cx="475" cy="414" rx="225" ry="24" fill="#000000" filter="url(#softShadow)" opacity="0.24"/>

      <g class="bike" stroke-linecap="round" stroke-linejoin="round">
        <g class="wheel" transform="translate(333 382)">
          <circle r="68" fill="#111827"/>
          <circle r="57" fill="#f8fafc"/>
          <use href="#wheelSpokes"/>
          <circle r="9" fill="#111827"/>
        </g>

        <g class="wheel" transform="translate(626 382)">
          <circle r="68" fill="#111827"/>
          <circle r="57" fill="#f8fafc"/>
          <use href="#wheelSpokes"/>
          <circle r="9" fill="#111827"/>
        </g>

        <path d="M333 382 L414 293 L480 354 L626 382 L537 293 L414 293 L480 354 L333 382"
              fill="none" stroke="var(--bike-red)" stroke-width="13"/>
        <path d="M414 293 L399 256" fill="none" stroke="var(--bike)" stroke-width="10"/>
        <path d="M382 256 L433 256" fill="none" stroke="var(--bike)" stroke-width="10"/>
        <path d="M537 293 L577 248" fill="none" stroke="var(--bike)" stroke-width="10"/>
        <path d="M577 248 L616 252" fill="none" stroke="var(--bike)" stroke-width="9"/>
        <path d="M626 382 L577 248" fill="none" stroke="var(--bike)" stroke-width="10"/>
        <path d="M333 382 L399 256" fill="none" stroke="var(--bike)" stroke-width="8" opacity="0.75"/>

        <g class="crank">
          <circle cx="480" cy="354" r="17" fill="#111827"/>
          <line x1="480" y1="354" x2="527" y2="337" stroke="#111827" stroke-width="8"/>
          <line x1="480" y1="354" x2="433" y2="371" stroke="#111827" stroke-width="8"/>
          <g class="pedal">
            <rect x="520" y="332" width="34" height="9" rx="4" fill="#111827"/>
            <rect x="406" y="367" width="34" height="9" rx="4" fill="#111827"/>
          </g>
        </g>
      </g>

      <g class="pelican">
        <g class="back-leg">
          <path d="M438 296 C442 321 448 342 433 371" fill="none" stroke="#fbbf24" stroke-width="13" stroke-linecap="round"/>
          <path d="M427 371 L407 371" fill="none" stroke="#f59e0b" stroke-width="9" stroke-linecap="round"/>
        </g>

        <g class="front-leg">
          <path d="M500 297 C514 318 522 326 527 337" fill="none" stroke="#fbbf24" stroke-width="13" stroke-linecap="round"/>
          <path d="M528 337 L553 337" fill="none" stroke="#f59e0b" stroke-width="9" stroke-linecap="round"/>
        </g>

        <g class="tail">
          <path d="M376 262 C328 239 314 248 291 266 C323 264 343 277 374 288 Z"
                fill="var(--pelican-shadow)" stroke="#cdbf9e" stroke-width="3"/>
          <path d="M363 255 C335 244 318 248 303 258" fill="none" stroke="#fffaf0" stroke-width="8" stroke-linecap="round"/>
        </g>

        <path d="M384 217 C425 158 535 157 584 211 C620 251 600 304 536 322 C464 342 379 315 361 268 C355 250 363 231 384 217 Z"
              fill="var(--pelican-white)" stroke="#d7ccb6" stroke-width="4"/>
        <path d="M395 259 C435 287 503 298 565 274 C549 312 499 328 450 315 C418 307 397 288 395 259 Z"
              fill="var(--pelican-shadow)" opacity="0.95"/>

        <g class="wing">
          <path d="M425 231 C456 187 524 201 548 245 C518 235 495 261 477 292 C457 276 437 257 425 231 Z"
                fill="var(--wing)" stroke="#d7ccb6" stroke-width="4"/>
          <path d="M455 241 C477 232 504 233 527 248" fill="none" stroke="#dfd2b9" stroke-width="7" stroke-linecap="round"/>
          <path d="M466 266 C486 255 503 254 520 263" fill="none" stroke="#dfd2b9" stroke-width="6" stroke-linecap="round"/>
        </g>

        <g class="head">
          <path d="M559 188 C572 151 618 142 647 167 C680 194 660 232 617 230 C581 228 549 216 559 188 Z"
                fill="var(--pelican-white)" stroke="#d7ccb6" stroke-width="4"/>
          <path d="M633 187 C684 176 725 189 747 215 C710 219 668 221 626 215 C611 212 609 192 633 187 Z"
                fill="var(--beak)" stroke="var(--beak-dark)" stroke-width="4"/>
          <path d="M625 215 C667 222 708 224 747 215 C721 248 673 256 635 238 C623 232 619 223 625 215 Z"
                fill="#ffd27a" stroke="var(--beak-dark)" stroke-width="4"/>
          <path d="M650 203 C682 200 713 204 738 214" fill="none" stroke="var(--beak-dark)" stroke-width="3" opacity="0.55"/>
          <circle cx="614" cy="178" r="7" fill="#111827"/>
          <circle cx="616" cy="176" r="2" fill="#ffffff"/>
          <path d="M579 158 C595 142 625 141 645 160" fill="none" stroke="#f2e7d2" stroke-width="9" stroke-linecap="round"/>
        </g>

        <path d="M423 291 C450 306 493 311 529 300" fill="none" stroke="#ffffff" stroke-width="9" stroke-linecap="round" opacity="0.75"/>
      </g>

      <g opacity="0.85">
        <text x="34" y="56" font-size="24" font-weight="700" fill="#0f172a">SVG Pelican Bicycle Animation</text>
        <text x="35" y="84" font-size="14" fill="#334155">Pure HTML + CSS + SVG</text>
      </g>
    </svg>
  </main>
</body>
</html>